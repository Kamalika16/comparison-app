# Directories (defaults to backend/uploads and backend/outputs if unset)
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Max upload size per file, in bytes (default 10 MB)
MAX_UPLOAD_SIZE=10485760

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Fuzzy column-matching threshold (0-100)
COLUMN_MATCH_THRESHOLD=70

# Hours discrepancy tolerances (decimal hours)
HOURS_TOLERANCE_MINOR=0.25
HOURS_TOLERANCE_MAJOR=1.0
